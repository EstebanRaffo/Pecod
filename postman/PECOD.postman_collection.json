    {
      "name": "04 - Courses (HU1, HU4, HU5, HU8)",
      "item": [
        {
          "name": "Crear curso sin campos obligatorios",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{professorToken}}" }
            ],
            "url": "{{baseUrl}}/courses",
            "body": { "mode": "raw", "raw": "{\"name\": \"\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU5 - rechaza curso sin campos obligatorios', () => {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear curso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{professorToken}}" }
            ],
            "url": "{{baseUrl}}/courses",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Testing de Software\", \"description\": \"Curso introductorio de QA\", \"category\": \"QA\", \"tools\": \"Jest, Cypress\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU5 - curso creado sin publicar', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.isPublished).to.eql(false);",
                  "  pm.environment.set('courseId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo antes de publicar (no debe aparecer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU1 - catálogo no muestra cursos sin publicar', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().map(c => c.id);",
                  "  pm.expect(ids).to.not.include(pm.environment.get('courseId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar curso",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{professorToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU8 - curso publicado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().isPublished).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo con filtro por categoría (HU1)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses?category=QA"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU1 - el filtro por categoría devuelve el curso publicado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().map(c => c.id);",
                  "  pm.expect(ids).to.include(pm.environment.get('courseId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo con filtro sin resultados (HU1)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses?category=CategoriaInexistente"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU1 - sin resultados devuelve array vacío (sin error)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de curso - no inscripto (HU4)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU4 - detalle visible, isEnrolled=false antes de inscribirse', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().isEnrolled).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
