            ],
            "url": "{{baseUrl}}/uploads/presigned-url",
            "body": {
              "mode": "raw",
              "raw": "{\"fileName\": \"clase.mp4\", \"contentType\": \"video/mp4\", \"sizeBytes\": 600000000, \"kind\": \"video\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU5 - rechaza video que supera 500 MB', () => {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Enrollments (HU2, HU3)",
      "item": [
        {
          "name": "Inscribirse al curso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/enroll"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU2 - inscripción exitosa', () => {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Doble inscripción (debe fallar)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/enroll"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU2 - no permite doble inscripción', () => {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis cursos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/enrollments/my-courses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU3 - el curso inscripto aparece en Mis Cursos', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const courseIds = pm.response.json().map(e => e.course.id);",
                  "  pm.expect(courseIds).to.include(pm.environment.get('courseId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07 - Evaluations (HU11, HU12)",
      "item": [
        {
          "name": "Crear evaluación sin preguntas (debe fallar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{professorToken}}" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/evaluations",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Sin preguntas\", \"minScore\": 60, \"questions\": []}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU11 - no permite evaluación sin preguntas', () => {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear evaluación válida",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{professorToken}}" }
            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/evaluations",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Parcial 1\", \"minScore\": 60, \"questions\": [{\"text\": \"¿Qué es un criterio de aceptación?\", \"options\": [{\"text\": \"Una condición verificable\", \"isCorrect\": true}, {\"text\": \"Un comentario en el código\", \"isCorrect\": false}]}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU11 - evaluación creada con pregunta de opción múltiple', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('evaluationId', body.id);",
                  "  const question = body.questions[0];",
                  "  pm.environment.set('questionId', question.id);",
                  "  const correct = question.options.find(o => o.isCorrect);",
                  "  const wrong = question.options.find(o => !o.isCorrect);",
                  "  pm.environment.set('correctOptionId', correct.id);",
                  "  pm.environment.set('wrongOptionId', wrong.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rendir evaluación - intento 1 (respuesta incorrecta a propósito)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/evaluations/{{evaluationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\"answers\": [{\"questionId\": \"{{questionId}}\", \"selectedOptionId\": \"{{wrongOptionId}}\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU12 - intento 1 desaprobado (0%)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.passed).to.eql(false);",
                  "  pm.expect(body.score).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rendir evaluación - intento 2 (respuesta correcta)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/evaluations/{{evaluationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\"answers\": [{\"questionId\": \"{{questionId}}\", \"selectedOptionId\": \"{{correctOptionId}}\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU12 - intento 2 aprobado (100%)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.passed).to.eql(true);",
                  "  pm.expect(body.score).to.eql(100);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rendir evaluación - ya aprobada (debe fallar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/evaluations/{{evaluationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\"answers\": [{\"questionId\": \"{{questionId}}\", \"selectedOptionId\": \"{{correctOptionId}}\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU12 - no permite rendir de nuevo una evaluación ya aprobada', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include('Ya aprobaste');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
