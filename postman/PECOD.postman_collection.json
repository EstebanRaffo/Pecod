            ],
            "url": "{{baseUrl}}/courses/{{courseId}}/topics",
            "body": { "mode": "raw", "raw": "{\"title\": \"Introducción al testing\", \"order\": 1}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HU5 - tema creado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set('topicId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitar URL prefirmada - formato de video no soportado",
