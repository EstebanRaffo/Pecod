// PECOD - V1 - Esquema de base de datos
// Estrategia multi-tenant: institutionId en las tablas que dependen de una institución.
// Basado en las 12 HU de V1 (ver documento "Testing de Aplicaciones - TP Integrador").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // Administrador de Sistema (HU9, HU10)
  PROFESSOR // Profesor (HU5-HU8, HU11)
  STUDENT // Alumno (HU1-HU4, HU12)
}

model Institution {
  id           String   @id @default(uuid())
  name         String
  domain       String   @unique // dominio/subdominio único (HU9)
  address      String
  phone        String
  contactEmail String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  courses            Course[]
  emailDomains       InstitutionEmailDomain[] // HU23: dominios de email para auto-registro

  @@map("institutions")
}

// HU23: Dominios de email permitidos para auto-registro por institución
model InstitutionEmailDomain {
  id            String   @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  domain        String       // dominio normalizado (lowercase, sin @)
  createdAt     DateTime @default(now())

  @@unique([institutionId, domain])
  @@index([domain])
  @@map("institution_email_domains")
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  // El Administrador de Sistema (HU9) no pertenece a ninguna institución (alcance global, HU10).
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id])
  // HU22: timestamp de último cambio de contraseña; usado para invalidar tokens JWT anteriores
  passwordChangedAt DateTime?
  // HU23: timestamp de verificación de email; null si no verificado
  emailVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coursesAsProfessor Course[]           @relation("ProfessorCourses")
  enrollments        Enrollment[]
  evaluationAttempts EvaluationAttempt[]
  notifications      Notification[]
  certificates       Certificate[]
  courseReviews      CourseReview[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[] // HU23
  forumThreads       ForumThread[]      @relation("ForumThreads") // HU25
  forumPosts         ForumPost[]        @relation("ForumPosts") // HU25

  @@index([institutionId])
  @@map("users")
}

// HU22: Tokens para restablecimiento de contraseña
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // hash SHA-256 del token; se envía el token en claro al usuario
  expiresAt DateTime // 60 minutos de vigencia
  usedAt    DateTime? // si es no-nulo, el token fue usado
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// HU23: Tokens para verificación de email en auto-registro
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // hash SHA-256 del token; se envía el token en claro al usuario
  expiresAt DateTime // 24 horas de vigencia
  usedAt    DateTime? // si es no-nulo, el token fue usado
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model Course {
  id            String   @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  professorId   String
  professor     User        @relation("ProfessorCourses", fields: [professorId], references: [id])

  name        String
  description String
  category             String // área de conocimiento (HU1 filtro)
  technology           String? // tecnología del curso
  academicRequirements String? // requerimientos académicos
  skills               String? // aptitudes que se adquieren
  isPublished Boolean  @default(false) // HU5 (alta) / HU8 (despublicar-republicar)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  enrollments Enrollment[]
  evaluations Evaluation[]
  notifications Notification[]
  certificates  Certificate[]
  reviews     CourseReview[] @relation("courseReviews")
  forumThreads ForumThread[]  // HU25

  @@index([institutionId, isPublished])
  @@index([category])
  @@map("courses")
}

model Topic {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  title                String
  order                Int
  videoUrl             String? // S3 key/URL del video subido como archivo (HU5)
  screenRecordingUrl   String? // S3 key/URL del video de grabación de pantalla (HU6)
  videoDurationSeconds Int? // máx. 1800s (30 min) validado en el service
  contentText          String? // material teórico escrito (HU7)

  materials    Material[]
  evaluations  Evaluation[]
  progress     TopicProgress[]
  notifications Notification[]
  forumThreads ForumThread[]  // HU25

  @@index([courseId])
  @@map("topics")
}

enum ContentEvent {
  NEW_CONTENT
  UPDATED_CONTENT
  COURSE_RECOMMENDED // HU24: recomendación de cursos
}

model Notification {
  id         String @id @default(uuid())
  studentId  String
  student    User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId    String?
  topic      Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  courseName String
  topicTitle String? // HU24: nullable para recomendaciones (topicTitle es null)
  event      ContentEvent
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([studentId, createdAt])
  @@map("notifications")
}

model Material {
  id      String @id @default(uuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id])

  fileName    String
  fileUrl     String // S3 key/URL
  fileType    String // pdf | xlsx | docx | txt (HU7)
  sizeBytes   Int // máx. 10 MB validado en el service
  uploadedAt  DateTime @default(now())

  @@index([topicId])
  @@map("materials")
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())
  topicProgress TopicProgress[]
  certificate   Certificate?

  @@unique([studentId, courseId]) // evita doble inscripción (HU2)
  @@map("enrollments")
}

model TopicProgress {
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  viewedAt     DateTime @default(now())

  @@id([enrollmentId, topicId])
  @@index([topicId])
  @@map("topic_progress")
}

model Evaluation {
  id       String  @id @default(uuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])
  topicId  String? // null = evaluación de cierre de curso (HU11)
  topic    Topic?  @relation(fields: [topicId], references: [id])

  title     String
  minScore  Int // puntaje mínimo de aprobación, 0-100 (HU11)
  maxAttempts Int @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  EvaluationAttempt[]

  @@index([courseId])
  @@map("evaluations")
}

model Question {
  id           String @id @default(uuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  text         String
  order        Int

  options QuestionOption[]

  @@index([evaluationId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
  @@map("question_options")
}

model EvaluationAttempt {
  id            String   @id @default(uuid())
  evaluationId  String
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id])
  studentId     String
  student       User       @relation(fields: [studentId], references: [id])

  attemptNumber Int // 1 o 2 (HU12: máximo 2 intentos en V1)
  score         Int
  passed        Boolean
  evaluationSnapshot Json
  createdAt     DateTime @default(now())

  @@unique([evaluationId, studentId, attemptNumber])
  @@index([evaluationId, studentId])
  @@map("evaluation_attempts")
}

model Certificate {
  id              String   @id @default(uuid())
  code            String   @unique
  enrollmentId    String   @unique
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentName     String
  courseName      String
  institutionName String
  professorName   String
  issuedAt        DateTime @default(now())

  @@index([studentId])
  @@index([courseId])
  @@map("certificates")
}

// HU20: Reseñas de cursos
model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation("courseReviews", fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5 estrellas
  comment   String?  // comentario opcional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@map("course_reviews")
}

// HU25: Foro de consultas por curso
model ForumThread {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  authorId  String
  author    User     @relation("ForumThreads", fields: [authorId], references: [id])
  title     String   @db.VarChar(120)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     ForumPost[]

  @@index([courseId, createdAt])
  @@index([topicId])
  @@map("forum_threads")
}

model ForumPost {
  id        String   @id @default(uuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ForumPosts", fields: [authorId], references: [id])
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("forum_posts")
}
