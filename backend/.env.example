# Base de datos
DATABASE_URL="postgresql://pecod:pecod@localhost:5432/pecod?schema=public"

# Auth (HU10)
JWT_SECRET="cambiar-por-un-secreto-largo-y-random"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# AWS S3 (HU5/HU6/HU7 - subida directa vía URL prefirmada)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="pecod-uploads"

# Mux (HU5/HU6 - transcodificación y streaming de video)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Límites técnicos (Supuestos técnicos V1)
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MIN=30
MAX_MATERIAL_SIZE_MB=10
MAX_EVALUATION_ATTEMPTS=2
